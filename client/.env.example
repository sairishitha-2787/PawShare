# Copy to .env.local and adjust. Vite only exposes variables that start with VITE_.

# Base URL of the PawShare API (server/). Default: http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# true = use the built-in sample pets (src/data/mockPets.js) instead of calling the API
VITE_USE_MOCK=false

# Pet photo uploads (Cloudinary, unsigned upload preset). Leave blank and the listing form asks for an image URL instead.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
